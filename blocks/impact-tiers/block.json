{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "teda/impact-tiers",
	"title": "TEDA Impact Tiers",
	"category": "teda",
	"icon": "money-alt",
	"description": "Donation tiers: an amount, what it buys and an optional progress bar. Progress bars carry a text label as well as a fill, so colour is never the only signal.",
	"keywords": [
		"teda",
		"impact",
		"donate",
		"tiers"
	],
	"textdomain": "teda-core",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "Your impact"
		},
		"heading": {
			"type": "string",
			"default": "What your gift does"
		},
		"show_header": {
			"type": "boolean",
			"default": true
		},
		"tier1_amount": {
			"type": "string",
			"default": "",
			"teda": {
				"group": "Tier 1"
			},
			"role": "content"
		},
		"tier1_usd": {
			"type": "string",
			"default": "",
			"teda": {
				"group": "Tier 1"
			},
			"role": "content"
		},
		"tier1_desc": {
			"type": "string",
			"default": "",
			"teda": {
				"control": "textarea",
				"group": "Tier 1"
			},
			"role": "content"
		},
		"tier1_progress": {
			"type": "integer",
			"default": 0,
			"teda": {
				"group": "Tier 1"
			}
		},
		"tier1_progress_label": {
			"type": "string",
