{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "teda/stat-band",
	"title": "TEDA Stat Band",
	"category": "teda",
	"icon": "chart-bar",
	"description": "Up to eight headline figures. Only figures you tick as verified are shown (SPEC §11). Below the minimum count (configurable), a single honest qualitative statement is shown instead of a thin band.",
