{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "teda/testimonials",
	"title": "TEDA Testimonials",
	"category": "teda",
	"icon": "format-quote",
	"description": "A carousel of member voices. Use a first name and district only — never a full name. Keyboard-operable, no autoplay.",
	"keywords": [
		"teda",
		"testimonials",
		"quotes",
		"voices"
	],
	"textdomain": "teda-core",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "Voices"
		},
		"heading": {
			"type": "string",
			"default": "What members say"
		},
		"show_header": {
			"type": "boolean",
			"default": true
		},
		"t1_quote": {
			"type": "string",
			"default": "",
			"teda": {
				"control": "textarea",
				"group": "Testimonial 1"
			},
			"role": "content"
		},
		"t1_name": {
			"type": "string",
			"default": "",
			"teda": {
				"group": "Testimonial 1"
			},
			"role": "content"
		},
		"t1_district": {
			"type": "string",
			"default": "",
			"teda": {
				"group": "Testimonial 1"
			},
